FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONNOUSERSITE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates tar \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir graphifyy

RUN useradd --uid 10001 --create-home --shell /usr/sbin/nologin forge

WORKDIR /work
USER 10001:10001

CMD ["sleep", "infinity"]
